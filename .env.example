# CI/CD Pipeline Security Auditor Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-use-strong-random-key

# Database
DATABASE_URL=sqlite:///instance/auditor.db

# GitHub API (Optional: increases rate limit from 60 to 5000 requests/hr)
GITHUB_TOKEN=

# AI-Powered Explainability (Optional: template fallback is used if empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

